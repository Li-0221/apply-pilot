{
  "name": "apply-pilot",
  "version": "0.1.0",
  "description": "基于 Electron 的本地求职助手，支持 BOSS 直聘登录、AI 简历匹配和自动投递。",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Li-0221/apply-pilot.git"
  },
  "homepage": "https://github.com/Li-0221/apply-pilot#readme",
  "bugs": {
    "url": "https://github.com/Li-0221/apply-pilot/issues"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "private": true,
  "type": "module",
  "main": "out/main.cjs",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm typecheck && node scripts/build.mjs && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "start": "electron .",
    "package": "pnpm build && node scripts/package.mjs",
    "test:live": "node scripts/live-check.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "44.7.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.5.0",
    "playwright": "1.59.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8"
  }
}
